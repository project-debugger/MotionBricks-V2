# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

# Upstream software clone + LFS assets (fetched by tools/fetch_upstream.py; Apache-2.0 code,
# BVH samples under the NVIDIA Sample Data Evaluation License -> never redistributed here)
third_party/

# Model weights: downloaded / generated locally, verified by checksum (see models/soma/checksums/)
models/soma/original/*
models/soma/optimized/onnx/
*.onnx
*.safetensors
*.part

# Local data derived from evaluation-licensed clips (never committed)
datasets/

# Local logs and benchmark output
logs/
benchmarks/

site/models/*/model.onnx.local
site/build/node_modules/
site/build/package-lock.json

# Downloaded third-party mocap (re-fetch with tools/mocap/style100.py fetch / tools/mocap/cmu.py fetch)
data/external/
site/data/raw_output.*
