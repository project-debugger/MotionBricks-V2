;; Expert-blended dense layer for the animal network (js/animalnet.js), 4 floats per instruction:
;;   out[o] = sum_k alpha[k] * (B[k][o] + sum_i x[i] * W[k][i][o])     (o padded to a multiple of 4)
;; Build: node build/tools/build_simd.cjs  (wat2wasm, then embedded in js/animalnet.js as base64)
(module
  (memory (export "mem") 1)
  (func (export "mix") (param $W i32) (param $B i32) (param $al i32) (param $x i32) (param $out i32)
                       (param $ni i32) (param $no i32) (param $K i32)
    (local $k i32) (local $i i32) (local $o i32) (local $a f32) (local $s v128) (local $row i32) (local $nb i32) (local $bk i32)
    (local.set $nb (i32.shl (local.get $no) (i32.const 2)))
    (local.set $o (i32.const 0))
    (block $zd (loop $zl
      (br_if $zd (i32.ge_u (local.get $o) (local.get $nb)))
      (v128.store (i32.add (local.get $out) (local.get $o)) (v128.const i32x4 0 0 0 0))
      (local.set $o (i32.add (local.get $o) (i32.const 16)))
      (br $zl)))
    (local.set $k (i32.const 0))
    (block $kd (loop $kl
      (br_if $kd (i32.ge_u (local.get $k) (local.get $K)))
      (local.set $a (f32.load (i32.add (local.get $al) (i32.shl (local.get $k) (i32.const 2)))))
      (local.set $s (f32x4.splat (local.get $a)))
      (local.set $bk (i32.add (local.get $B) (i32.mul (local.get $k) (local.get $nb))))
      (local.set $o (i32.const 0))
      (block $bd (loop $bl
        (br_if $bd (i32.ge_u (local.get $o) (local.get $nb)))
        (v128.store (i32.add (local.get $out) (local.get $o))
          (f32x4.add (v128.load (i32.add (local.get $out) (local.get $o)))
                     (f32x4.mul (local.get $s) (v128.load (i32.add (local.get $bk) (local.get $o))))))
        (local.set $o (i32.add (local.get $o) (i32.const 16)))
        (br $bl)))
      (local.set $row (i32.add (local.get $W) (i32.mul (i32.mul (local.get $k) (local.get $ni)) (local.get $nb))))
      (local.set $i (i32.const 0))
      (block $id (loop $il
        (br_if $id (i32.ge_u (local.get $i) (local.get $ni)))
        (local.set $s (f32x4.splat (f32.mul (local.get $a) (f32.load (i32.add (local.get $x) (i32.shl (local.get $i) (i32.const 2)))))))
        (local.set $o (i32.const 0))
        (block $od (loop $ol
          (br_if $od (i32.ge_u (local.get $o) (local.get $nb)))
          (v128.store (i32.add (local.get $out) (local.get $o))
            (f32x4.add (v128.load (i32.add (local.get $out) (local.get $o)))
                       (f32x4.mul (local.get $s) (v128.load (i32.add (local.get $row) (local.get $o))))))
          (v128.store (i32.add (local.get $out) (i32.add (local.get $o) (i32.const 16)))
            (f32x4.add (v128.load (i32.add (local.get $out) (i32.add (local.get $o) (i32.const 16))))
                       (f32x4.mul (local.get $s) (v128.load (i32.add (local.get $row) (i32.add (local.get $o) (i32.const 16)))))))
          (local.set $o (i32.add (local.get $o) (i32.const 32)))
          (br $ol)))
        (local.set $row (i32.add (local.get $row) (local.get $nb)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $il)))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $kl))))
)
